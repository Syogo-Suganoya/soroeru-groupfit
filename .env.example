# 実キーはコミットしない（本番は Secret Manager から Cloud Run に注入）
GEMINI_MODE=mock
YOUCAM_MODE=mock
NOTIFY_CHANNEL=in_app

# 重い画像合成・動画生成（設計書 §12）: local | gmi
COMPOSITOR_ENGINE=local
VIDEO_ENGINE=local

DB_DRIVER=firestore
STORAGE_DRIVER=local

GOOGLE_CLOUD_PROJECT=soroeru-groupfit-local
PUBLIC_BASE_URL=http://localhost:8080

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
GCS_BUCKET=

# GMI Cloud
GMI_API_KEY=
GMI_BASE_URL=https://api.gmicloud.ai/v1
GMI_IMAGE_MODEL=seedream
GMI_RELIGHT_MODEL=bria-fibo-relight
GMI_VIDEO_MODEL=image-to-video

COLOR_CLASH_DELTA_E=12
FORMALITY_GAP_THRESHOLD=2
TTL_DAYS_AFTER_EVENT=7
